{
  "schemaVersion": 1,
  "identity": {
    "packageName": "aurareader-workstation",
    "productName": "AuraReader",
    "appId": "org.aurareader.desktop",
    "repository": {
      "host": "github.com",
      "owner": "yhdmjywx",
      "name": "AuraReader"
    }
  },
  "packageManager": {
    "name": "npm",
    "versionSource": "unknown",
    "lockfile": "package-lock.json",
    "lockfileVersion": 3,
    "nodeEngine": ">=24.15.0"
  },
  "electron": {
    "declaredVersion": "45.0.0",
    "lockedVersion": "45.0.0",
    "packagingVersion": "45.0.0"
  },
  "packaging": {
    "tool": "electron-builder",
    "declaredVersion": "26.15.3",
    "lockedVersion": "26.15.3",
    "configurationFile": "electron-builder.cjs",
    "targets": [
      {
        "os": "windows",
        "arch": "x64",
        "format": "nsis"
      }
    ],
    "automaticPublishing": false,
    "signingConfiguration": "unknown"
  },
  "scripts": {
    "start": "node src/server/server.js",
    "prestart": "npm run build",
    "dev": "node scripts/dev.mjs",
    "desktop": "npm run build && node scripts/desktop.cjs",
    "dist:win": "npm run build && node scripts/package-resources.cjs && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never && node scripts/verify-package.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "test:install": "npm run dist:win && node scripts/package-upgrade-fixture.cjs && node scripts/test-install.cjs",
    "test:desktop": "npm run build && node scripts/test-desktop.cjs",
    "test:reading-workflow": "npm run build && node scripts/test-desktop.cjs reading-workflow.cjs",
    "test:migration": "node scripts/test.cjs migration",
    "test:stability": "npm run build && node scripts/test-stability.cjs",
    "test:packaged:stability": "node tests/desktop/packaged-stability.cjs",
    "test:desktop:native": "npm run build && node scripts/test-native-dialogs.cjs",
    "build": "node scripts/build.cjs && vite build",
    "build:modules": "node scripts/build.cjs",
    "typecheck": "node scripts/build.cjs --check",
    "test": "node scripts/test.cjs all",
    "test:syntax": "node scripts/test.cjs syntax",
    "test:unit": "node scripts/test.cjs unit",
    "test:regression": "node scripts/test.cjs regression",
    "test:all": "node scripts/test.cjs all"
  },
  "commands": {
    "build": "npm run build",
    "package": "npm run dist:win",
    "typecheck": "npm run typecheck",
    "test": "npm test",
    "lint": "unknown",
    "migration": "npm run test:migration",
    "desktop": "npm run test:desktop",
    "packageVerification": "npm run verify:package",
    "packageRuntimeVerification": "node tests/desktop/packaged-epub.cjs"
  },
  "outputDirectories": {
    "renderer": "dist/renderer",
    "testModules": "dist/client",
    "package": "release",
    "unpacked": "release/win-unpacked"
  },
  "version": {
    "source": "package.json#version",
    "lockfileSources": [
      "package-lock.json#version",
      "package-lock.json#packages[\"\"]#version"
    ],
    "tagConvention": "unknown"
  },
  "releaseArtifactPatterns": [
    "release/AuraReader-Setup-${version}-x64.exe",
    "release/AuraReader-Setup-${version}-x64.exe.sha256"
  ],
  "verificationReportPattern": "release/package-verification.json",

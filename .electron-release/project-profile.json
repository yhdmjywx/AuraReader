  "validationCoverage": {
    "source": {
      "command": "npm test",
      "covers": [
        "strict-types",
        "build:modules",
        "vite-build",
        "server-syntax",
        "unit",
        "regression",
        "migration-16"
      ],
      "source": "scripts/test.cjs"
    },
    "desktop": {
      "command": "node scripts/test-desktop.cjs",
      "prerequisite": "current npm test build outputs",
      "covers": [
        "reading-workflow",
        "lifecycle-empty",
        "lifecycle-save-guard"
      ],
      "source": "scripts/test-desktop.cjs"
    },
    "package": {
      "command": "npm run dist:win",
      "covers": [
        "production-build",
        "package-resources",
        "nsis-x64",
        "verify:package"
      ],
      "source": "package.json#scripts.dist:win"
    },
    "packagedRuntime": {
      "command": "node tests/desktop/packaged-epub.cjs",
      "covers": [
        "isolated-boot",
        "epub-workers-resources",
        "reload",
        "close-flush",
        "restart",
        "normal-exits"
      ],
      "source": "tests/desktop/packaged-epub.cjs"
    }
  }

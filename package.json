{
  "name": "aurareader-workstation",
  "version": "1.0.0",
  "description": "AuraReader Workstation - Smart Reading & Notes Workstation",
  "main": "src/server/server.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node src/server/server.js",
    "prestart": "npm run build",
    "dev": "npm run build && node src/server/server.js",
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.cjs all",
    "test:syntax": "node scripts/test.cjs syntax",
    "test:unit": "node scripts/test.cjs unit",
    "test:regression": "node scripts/test.cjs regression",
    "test:all": "node scripts/test.cjs all"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "jsdom": "^30.1.2",
    "jszip": "^3.10.1",
    "typescript": "5.9.3"
  },
  "keywords": [
    "reader",
    "epub",
    "notes"
  ],
  "author": "Antigravity",
  "license": "Apache-2.0",
  "dependencies": {
    "fontkit": "^2.0.4"
  }
}
